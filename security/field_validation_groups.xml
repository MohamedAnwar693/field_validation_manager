<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ===================================================== -->
    <!-- User Group -->
    <!-- ===================================================== -->
    <record id="group_field_validation_user" model="res.groups">
        <field name="name">Field Validation User</field>

        <!-- Must be internal user -->
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>

        <field name="comment">
            Can run import validation wizards and download templates.
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- Manager Group -->
    <!-- ===================================================== -->
    <record id="group_field_validation_manager" model="res.groups">
        <field name="name">Field Validation Manager</field>

        <!-- Manager inherits User -->
        <field name="implied_ids"
               eval="[(4, ref('field_validation_manager.group_field_validation_user'))]"/>

        <field name="comment">
            Can create and manage validation rules and rule sets.
        </field>
    </record>

</odoo>
