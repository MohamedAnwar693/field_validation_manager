<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_field_validation_ruleset_form" model="ir.ui.view">
        <field name="name">field.validation.ruleset.form</field>
        <field name="model">field.validation.ruleset</field>
        <field name="arch" type="xml">
            <form string="Validation Rule Set">
                <sheet>
                    <widget name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Product Import – Full Validation"/></h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Usage Stats">
                            <field name="import_count" readonly="1"/>
                            <field name="last_used" readonly="1"/>
                            <field name="rule_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="description"
                           placeholder="Describe what scenarios this rule set covers…"/>
                    <separator string="Validation Rules"/>
                    <field name="rule_ids"
                           domain="[('model_id', '=', model_id)]"
                           widget="many2many"
                           context="{'default_model_id': model_id}">
                        <list string="Rules" decoration-danger="severity == 'error'">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="field_id" string="Field"/>
                            <field name="rule_type"/>
                            <field name="severity" widget="badge"
                                   decoration-danger="severity == 'error'"
                                   decoration-warning="severity == 'warning'"/>
                            <field name="active" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <separator string="Template Settings"/>
                    <group>
                        <field name="include_example_row"/>
                        <field name="template_notes"
                               placeholder="Notes included in the generated template sheet…"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_field_validation_ruleset_list" model="ir.ui.view">
        <field name="name">field.validation.ruleset.list</field>
        <field name="model">field.validation.ruleset</field>
        <field name="arch" type="xml">
            <list string="Rule Sets" decoration-muted="not active">
                <field name="name"/>
                <field name="model_id"/>
                <field name="rule_count" string="Rules"/>
                <field name="import_count" string="Imports Run"/>
                <field name="last_used" optional="show"/>
                <field name="active" widget="boolean_toggle" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="action_field_validation_ruleset" model="ir.actions.act_window">
        <field name="name">Rule Sets</field>
        <field name="res_model">field.validation.ruleset</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No rule sets defined yet.
            </p>
            <p>
                Bundle related validation rules into named sets
                for different import scenarios.
            </p>
        </field>
    </record>
</odoo>
