<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================= FORM VIEW ================= -->
    <record id="view_field_validation_log_form" model="ir.ui.view">
        <field name="name">field.validation.log.form</field>
        <field name="model">field.validation.log</field>
        <field name="arch" type="xml">
            <form string="Validation Log" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="log_ref" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Context">
                            <field name="user_id" readonly="1"/>
                            <field name="create_date" string="Date" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="ruleset_id" readonly="1"/>
                            <field name="source" readonly="1"/>
                        </group>

                        <group string="Results">
                            <field name="total_rows" readonly="1"/>
                            <field name="passed_rows" readonly="1"/>
                            <field name="error_rows" readonly="1"/>
                            <field name="warning_rows" readonly="1"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'passed'"
                                   decoration-warning="status == 'warnings'"
                                   decoration-danger="status == 'failed'"
                                   readonly="1"/>
                        </group>
                    </group>

                    <separator string="Error Details"/>

                    <!-- FIX: use TREE instead of LIST -->
                    <field name="detail_ids" readonly="1">
                        <list string="Details"
                              decoration-danger="severity == 'error'"
                              decoration-warning="severity == 'warning'">
                            <field name="row_number"/>
                            <field name="field_label"/>
                            <field name="value"/>
                            <field name="severity" widget="badge"/>
                            <field name="message"/>
                            <field name="rule_id"/>
                        </list>
                    </field>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ================= LIST VIEW ================= -->
    <record id="view_field_validation_log_list" model="ir.ui.view">
        <field name="name">field.validation.log.list</field>
        <field name="model">field.validation.log</field>
        <field name="arch" type="xml">
            <list string="Validation Logs"
                  create="false"
                  decoration-danger="status == 'failed'"
                  decoration-warning="status == 'warnings'">

                <field name="log_ref"/>
                <field name="create_date" string="Date"/>
                <field name="user_id" string="User"/>
                <field name="model_name" string="Model"/>
                <field name="source" widget="badge"/>
                <field name="total_rows" string="Rows"/>
                <field name="error_rows" string="Errors"/>
                <field name="warning_rows" string="Warnings"/>
                <field name="passed_rows" string="Passed"/>

                <field name="status" widget="badge"
                       decoration-success="status == 'passed'"
                       decoration-warning="status == 'warnings'"
                       decoration-danger="status == 'failed'"/>
            </list>
        </field>
    </record>


    <!-- ================= SEARCH VIEW ================= -->
    <record id="view_field_validation_log_search" model="ir.ui.view">
        <field name="name">field.validation.log.search</field>
        <field name="model">field.validation.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">

                <!-- ONLY keep fields that are 100% stored in DB -->
                <field name="log_ref"/>

                <separator/>

                <filter name="failed" string="Errors Found"
                        domain="[('status','=','failed')]"/>

                <filter name="warnings" string="Warnings"
                        domain="[('status','=','warnings')]"/>

                <filter name="passed" string="All Passed"
                        domain="[('status','=','passed')]"/>

            </search>
        </field>
    </record>

    <!-- ================= ACTION ================= -->
    <record id="action_field_validation_log" model="ir.actions.act_window">
        <field name="name">Validation Logs</field>
        <field name="res_model">field.validation.log</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today': 1}</field>
    </record>


    <!-- ================= DETAIL LIST ================= -->
    <record id="view_field_validation_log_line_list" model="ir.ui.view">
        <field name="name">field.validation.log.line.list</field>
        <field name="model">field.validation.log.line</field>
        <field name="arch" type="xml">
            <list string="Validation Details"
                  decoration-danger="severity == 'error'"
                  decoration-warning="severity == 'warning'">

                <field name="log_id"/>
                <field name="row_number" string="Row"/>
                <field name="field_label" string="Field"/>
                <field name="value"/>
                <field name="severity" widget="badge"/>
                <field name="message"/>
                <field name="rule_id"/>

            </list>
        </field>
    </record>

</odoo>